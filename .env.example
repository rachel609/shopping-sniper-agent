# ===== Shopping Sniper Agent Environment =====
# Copy this file to .env and replace with your real keys:
#   cp .env.example .env

# Required for live mode (LLM agent)
XAI_API_KEY=your_xai_api_key_here

# Optional: Google Custom Search (fallback search engine)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Optional: Gemini (not currently used, reserved)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional: Email notifications (Gmail App Password recommended)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
NOTIFY_EMAIL_TO=recipient@example.com
